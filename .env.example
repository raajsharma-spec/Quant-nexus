# Quantum Nexus — environment variables
#
# Quantum Nexus runs with NO environment variables at all:
#   npm install
#   npm run dev
#
# Everything below is OPTIONAL. To use it, copy this file to ".env.local"
# (same folder) and edit the copy. Never commit ".env.local".
#
# There are no secrets here. Do not put API keys, passwords or tokens in any
# variable that starts with NEXT_PUBLIC_ — those are sent to the browser.

# Address of the optional Qiskit Aer service (see backend/README.md).
# Leave empty to run every circuit in the browser simulator.
# Local example:  NEXT_PUBLIC_QISKIT_API_URL=http://localhost:8000
NEXT_PUBLIC_QISKIT_API_URL=
